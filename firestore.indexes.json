{
  "_comment": "Composite indexes from PRD section 10. Deploy with 'firebase deploy --only firestore:indexes', or create them in the Console. Single-field ranges (memberships.endDate, users.activeUntil, users.name, users.email, users.phone) are covered by Firestore's automatic indexes and are not listed here.",
  "indexes": [
    {
      "_comment": "Admin payments tabs: status + newest first.",
      "collectionGroup": "paymentRequests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "A member's own payment history.",
      "collectionGroup": "paymentRequests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Duplicate UTR lookup.",
      "collectionGroup": "paymentRequests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "upiRef", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Income this month: approved requests by review date.",
      "collectionGroup": "paymentRequests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "reviewedAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "A member's memberships, latest-ending first.",
      "collectionGroup": "memberships",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "endDate", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Published classes in display order.",
      "collectionGroup": "classes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "published", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Active plans in display order.",
      "collectionGroup": "plans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
